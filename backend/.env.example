# Copy to .env for local development (.env is git-ignored).
# Matches `make db`; never put production credentials here.
# development or production. Unset means production, which turns off
# development-only tools such as `cargo run -- seed`.
APP_ENV=development
# The owner's login: migrations, the seed and admin commands (and the tests).
DATABASE_URL=postgres://solacliq:solacliq@127.0.0.1:5432/solacliq
# The login the server answers requests with: restricted by row-level
# security, so it sees only the rows of each request's scope. `make db`
# creates it; the server won't start if it could bypass the policies.
APP_DATABASE_URL=postgres://solacliq_api:solacliq_api@127.0.0.1:5432/solacliq
BIND_ADDR=127.0.0.1:8080
DB_MAX_CONNECTIONS=10
LOG_JSON=false
# The website's cookie is HTTPS-only unless this is false (local HTTP only).
COOKIE_SECURE=false
# Session lifetimes. Unset means these defaults.
# Access token, before the app or website must refresh it.
ACCESS_TOKEN_MINUTES=15
# Refresh token: how long someone stays logged in without opening the app or site.
REFRESH_TOKEN_DAYS=30
# RUST_LOG=info,backend=debug,tower_http=debug
# Required. Key for hashing the 6-digit email codes. Generate one per
# environment with: openssl rand -hex 32
CODE_SECRET=
# Required. MarkCliq's inbox for new company registrations.
REVIEW_EMAIL=info@markcliq.com
# Email through the Gmail API (docs/architecture.md, "Email"). Both, or
# neither: unset, emails are printed to the log, which only development
# allows. MAIL_FROM is a Workspace user the service account acts as.
# MAIL_FROM="SolaCliq <support@solacliq.markcliq.com>"
# GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/path/outside/the/repo/gmail-sender.json
# Required. Encrypts payout bank account numbers. 64 hex characters, one
# per environment, never changed once real accounts are stored:
# openssl rand -hex 32
BANK_KEY=
# Cloudflare R2 for uploads (docs/architecture.md, "Uploads"). All four, or
# none: unset, POST /uploads answers 503, which only development allows.
# The key pair is an R2 API token's S3 credentials, Object Read & Write on
# this one bucket only. Never commit real values.
# R2_ACCOUNT_ID=
# R2_BUCKET=solacliq-uploads-dev
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
