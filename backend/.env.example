# Copy to .env for local development (.env is git-ignored).
# Matches `make db`; never put production credentials here.
DATABASE_URL=postgres://solacliq:solacliq@127.0.0.1:5432/solacliq
BIND_ADDR=127.0.0.1:8080
DB_MAX_CONNECTIONS=10
LOG_JSON=false
# The website's cookie is HTTPS-only unless this is false (local HTTP only).
COOKIE_SECURE=false
# Session lifetimes. Unset means these defaults.
# App access token, before the app must refresh it.
ACCESS_TOKEN_MINUTES=15
# How long the app stays logged in without being opened.
REFRESH_TOKEN_DAYS=30
# The website's cookie.
WEB_SESSION_HOURS=12
# RUST_LOG=info,backend=debug,tower_http=debug
