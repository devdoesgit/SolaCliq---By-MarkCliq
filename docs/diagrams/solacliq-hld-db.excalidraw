   "seed": 249103477,
   "version": 1,
   "versionNonce": 922121676,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1794700000000,
   "link": null,
   "locked": false,
   "text": "Changed from the draft\n- Organization → orgs; Users/Members → users\n- emailId → email; passowrd_hash → password_hash\n- pinCode → pin_code (snake_case, like the\n  rest of the database)\n- orgs: added name, phone, status\n- memberships: status → removed_at (soft\n  delete); added pay_type, created_at\n- \"invited\" is worked out from\n  users.password_hash being empty, so\n  memberships needs no status\n- users.password_hash empty = invited\n  (no password set yet)",
   "originalText": "Changed from the draft\n- Organization → orgs; Users/Members → users\n- emailId → email; passowrd_hash → password_hash\n- pinCode → pin_code (snake_case, like the\n  rest of the database)\n- orgs: added name, phone, status\n- memberships: status → removed_at (soft\n  delete); added pay_type, created_at\n- \"invited\" is worked out from\n  users.password_hash being empty, so\n  memberships needs no status\n- users.password_hash empty = invited\n  (no password set yet)",
   "fontSize": 22,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "baselineFixed": null,
   "index": "b01"
