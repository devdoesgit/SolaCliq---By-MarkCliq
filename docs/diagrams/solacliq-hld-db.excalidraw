  {
   "id": "c0000269e0d37",
   "type": "text",
   "x": 808.9485309601816,
   "y": 663.4166666666588,
   "width": 417.59999999999997,
   "height": 360.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
