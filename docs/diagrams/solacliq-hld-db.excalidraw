   "seed": 207388624,
   "version": 1,
   "versionNonce": 311111475,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1794700000000,
   "link": null,
   "locked": false,
   "text": "one role per person per org\n\nrole: org_admin | worker |\n      agent | customer\npay_type: commission | salary\nCHECK: pay_type set only\n       for agents\none org_admin per org\n  (unique where removed_at\n   is null)\nrole, pay_type, status:\n  native Postgres enums",
   "originalText": "one role per person per org\n\nrole: org_admin | worker |\n      agent | customer\npay_type: commission | salary\nCHECK: pay_type set only\n       for agents\none org_admin per org\n  (unique where removed_at\n   is null)\nrole, pay_type, status:\n  native Postgres enums",
   "fontSize": 24,
   "fontFamily": 8,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25,
   "baselineFixed": null,
