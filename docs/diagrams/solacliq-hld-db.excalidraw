  },
  {
   "id": "c00011818e811",
   "type": "text",
   "x": 1442.1408386524895,
   "y": -766.142077323714,
   "width": 633.6,
   "height": 357.5,
   "angle": 0,
   "strokeColor": "#6741d9",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
