# Production settings for the API container. On the server only, as
# /etc/solacliq/solacliq.env, owner root, mode 600 (docker compose reads
# it as root). Never commit the filled-in file. Each value is explained in
# backend/.env.example. BIND_ADDR is set by compose.yml.

APP_ENV=production
LOG_JSON=true
# Info and above: the default also logs every request, and the container's
# health check alone is one every 10 seconds.
RUST_LOG=info,sqlx::postgres::notice=warn
COOKIE_SECURE=true
DB_MAX_CONNECTIONS=10

# The two logins the database container makes on its first start, with
# the passwords in db.env (SOLACLIQ_OWNER_PASSWORD, SOLACLIQ_API_PASSWORD).
# `db` is the database container's name on compose's internal network.
DATABASE_URL=postgres://solacliq:OWNER_PASSWORD@db:5432/solacliq
APP_DATABASE_URL=postgres://solacliq_api:API_PASSWORD@db:5432/solacliq

# openssl rand -hex 32, each one new for production. Keep a copy of
# BANK_KEY in your password manager: losing it loses every stored bank
# account number, and it can never be changed once accounts are saved.
CODE_SECRET=
BANK_KEY=

REVIEW_EMAIL=info@markcliq.com

MAIL_FROM="SolaCliq <support@solacliq.markcliq.com>"
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/etc/solacliq/gmail-sender.json

FCM_SERVICE_ACCOUNT_KEY_FILE=/etc/solacliq/firebase-key.json

# The production bucket's own token (solacliq-uploads-prod), never the dev one.
R2_ACCOUNT_ID=
R2_BUCKET=solacliq-uploads-prod
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# true deletes KYC past its retention for good (F18); false only logs it.
KYC_RETENTION=false
