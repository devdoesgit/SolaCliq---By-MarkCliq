# Production settings. On the server only, as /etc/solacliq/solacliq.env,
# owner root, group solacliq, mode 640. Never commit the filled-in file.
# Each value is explained in backend/.env.example.

APP_ENV=production
BIND_ADDR=127.0.0.1:8080
LOG_JSON=true
COOKIE_SECURE=true
DB_MAX_CONNECTIONS=10

# The two logins made by db-setup.sql, with the passwords you chose there.
DATABASE_URL=postgres://solacliq:OWNER_PASSWORD@127.0.0.1:5432/solacliq
APP_DATABASE_URL=postgres://solacliq_api:API_PASSWORD@127.0.0.1:5432/solacliq

# openssl rand -hex 32, each one new for production. Keep a copy of
# BANK_KEY in your password manager: losing it loses every stored bank
# account number, and it can never be changed once accounts are saved.
CODE_SECRET=
BANK_KEY=

REVIEW_EMAIL=info@markcliq.com

MAIL_FROM="SolaCliq <support@solacliq.markcliq.com>"
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/etc/solacliq/gmail-sender.json

FCM_SERVICE_ACCOUNT_KEY_FILE=/etc/solacliq/firebase-key.json

# The production bucket's own token (solacliq-uploads), never the dev one.
R2_ACCOUNT_ID=
R2_BUCKET=solacliq-uploads
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
