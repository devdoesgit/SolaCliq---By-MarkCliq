# SolaCliq's site, for the VPS's Caddy. Add this block to /etc/caddy/Caddyfile
# (or `import` this file from it), then `sudo systemctl reload caddy`.
# Caddy gets and renews the HTTPS certificate itself.
solacliq.markcliq.com {
	encode zstd gzip

	# The Rust API, which serves everything under /api/v1. X-Real-IP is the
	# visitor's address for the API's rate limits; it is set here, so a
	# visitor can't send their own.
	handle /api/* {
		# People's data and signed file links: never kept by a cache.
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Real-IP {remote_host}
		}
	}

	# The admin website's built files. Each name changes with its content,
	# so one that's there is kept for good; one that isn't is a 404, never
	# index.html served as a script.
	handle /assets/* {
		root * /opt/solacliq/current/admin
		@built file
		header @built Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# index.html for every page. Always checked again: a kept copy would
	# ask for the last release's files and show a blank page.
	handle {
		root * /opt/solacliq/current/admin
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}

	header {
		# Only this site's own code runs. Files (photos, KYC, the logo
		# being uploaded) go straight to and from R2 with signed links.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self' data:; img-src 'self' data: blob: https://*.r2.cloudflarestorage.com; connect-src 'self' https://*.r2.cloudflarestorage.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
