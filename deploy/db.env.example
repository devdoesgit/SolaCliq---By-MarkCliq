# The database container's passwords. On the server only, as
# /etc/solacliq/db.env, owner root, mode 600. Never commit the filled-in file.
# Read once, when the database volume is first created: changing them later
# changes nothing (change a password in Postgres itself, then here).
# Each one: openssl rand -hex 24

# Postgres's own superuser, used only by backup.sh and restore.sh.
POSTGRES_PASSWORD=
# The owner login (runs the migrations): DATABASE_URL in solacliq.env.
SOLACLIQ_OWNER_PASSWORD=
# The login the API answers requests with: APP_DATABASE_URL in solacliq.env.
SOLACLIQ_API_PASSWORD=
