# Daily database backup (solacliq-backup.timer runs it): a dump per day in
# /var/backups/solacliq, outside Docker, the last 14 kept. Restore one with
# restore.sh (deploy/README.md, "Restore a backup").
[Unit]
Description=SolaCliq database backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/solacliq/backup.sh
