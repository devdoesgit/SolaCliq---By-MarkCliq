# Daily database backup (solacliq-backup.timer runs it). A custom-format
# dump per day in /var/backups/solacliq, the last 14 kept. Restore one with
# pg_restore (deploy/README.md, "Restore a backup").
[Unit]
Description=SolaCliq database backup
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0077
ExecStart=/bin/sh -c 'pg_dump --format=custom --file=/var/backups/solacliq/solacliq-$(date +%%Y%%m%%d-%%H%%M).dump solacliq'
ExecStartPost=/usr/bin/find /var/backups/solacliq -name 'solacliq-*.dump' -mtime +14 -delete
